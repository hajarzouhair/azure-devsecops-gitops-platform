{
  "title": "Portfolio App - Vue d'ensemble",
  "panels": [
    {
      "title": "Taux de requêtes HTTP (par statut)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"portfolio-app\"}[5m])) by (status)"
        }
      ]
    },
    {
      "title": "Latence p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"portfolio-app\"}[5m])) by (le))"
        }
      ]
    },
    {
      "title": "Utilisation CPU (% des limits)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"dev\", pod=~\"portfolio-app.*\"}[5m])) / sum(kube_pod_container_resource_limits{namespace=\"dev\", pod=~\"portfolio-app.*\", resource=\"cpu\"}) * 100"
        }
      ]
    },
    {
      "title": "Nombre de replicas (HPA)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"dev\", horizontalpodautoscaler=\"portfolio-app\"}"
        }
      ]
    }
  ]
}
